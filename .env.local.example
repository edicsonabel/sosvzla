# ============================================================
# Copia este archivo a .env.local y rellena con tus datos.
# Credenciales en: Supabase Dashboard > Project Settings > API
#
# ESTRATEGIA DE ENTORNOS (dos proyectos Supabase):
#   - LOCAL  -> usa el proyecto de DESARROLLO (dev).
#   - VERCEL -> usa el proyecto de PRODUCCIÓN (prod), configurado en
#               Vercel > Project Settings > Environment Variables.
#
# El código siempre lee las variables SIN sufijo. En cada entorno esas
# variables apuntan al proyecto correcto. Usa solo la *publishable key*
# (sb_publishable_...). NUNCA la secret key en el frontend.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO-DEV.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
